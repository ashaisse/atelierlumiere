    font-weight: 500;
    letter-spacing: 0.02em;
  }

  header {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(180deg, #f7f1ea 0%, #ece2d4 100%);
    padding: 2rem;
  }

  header h1 {
    font-size: 4.5rem;
    font-style: italic;
    color: #5c4a3a;
  }

  header p {
    margin-top: 1rem;
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8a7866;
  }

  nav {
    margin-top: 2.5rem;
    display: flex;
    gap: 2.5rem;
  }

